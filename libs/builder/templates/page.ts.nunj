// @ts-nocheck
import {ChangeDetectionStrategy, Component} from '@angular/core';
import {Routes} from '@angular/router';
import {NgDocDemoAssets, NgDocPageComponent, NgDocRootPage} from '@ng-doc/app';
import {isRoute, NgDocPage, NgDocPageType} from '@ng-doc/core';
{%- if entryPath %}
import entry from '{{ metadata.outDir | createImportPath(entryPath) }}';
{%- endif %}
{%- if playgroundsPath %}
import {PLAYGROUND_COMPONENTS, PLAYGROUND_PROVIDERS} from '{{ metadata.outDir | createImportPath(playgroundsPath) }}';
{%- endif %}
{%- if demoAssetsPath %}
import demoAssets from '{{ metadata.outDir | createImportPath(demoAssetsPath) }}';
{%- endif %}
{%- if contentSourceImport %}
import {ɵwithNgDocContent} from '@ng-doc/app';
import pageContentSource from '{{ contentSourceImport }}';
{%- endif %}

{%- if contentSourceImport %}
const pageContent: string = '';
{%- else %}
const pageContent: string = `{{ content | toTemplateString }}`
{%- endif %}

@Component({
  selector: 'ng-doc-page-{{ id }}',
  template: `<ng-doc-page></ng-doc-page>`,
  changeDetection: ChangeDetectionStrategy.OnPush,
  imports: [
    NgDocPageComponent,
      {%- if entryPath and entryHasImports %}
    ...entry.imports,
      {%- endif %}
      {%- if playgroundsPath %}
    ...PLAYGROUND_COMPONENTS,
      {%- endif %}
  ],
  providers: [
    {provide: NgDocRootPage, useExisting: PageComponent},
      {%- if playgroundsPath %}
    PLAYGROUND_PROVIDERS,
      {%- endif %}
      {%- if entryPath %}
    (entry.providers ?? []),
      {%- endif %}
  ],
})
export class PageComponent extends NgDocRootPage {
  readonly pageType: NgDocPageType = '{{ pageType }}';
  readonly pageContent: string = pageContent;
    {%- if contentSourceImport %}
  readonly pageContentSource = pageContentSource;
    {%- endif %}
    {%- if editSourceFileUrl %}
  readonly editSourceFileUrl: string = '{{ editSourceFileUrl }}';
    {%- endif %}
    {%- if viewSourceFileUrl %}
  readonly viewSourceFileUrl: string = '{{ viewSourceFileUrl }}';
    {%- endif -%}
    {%- if entryPath %}
  readonly page?: NgDocPage = entry;
    {%- endif %}
    {%- if demoAssetsPath %}
  readonly demoAssets: NgDocDemoAssets = demoAssets;
    {%- endif %}
    {#- The demo pages of the guide (Vite engine), and whether its demos are isolated by default. #}
    {%- if demoRoute %}
  readonly demoRoute: string = '{{ demoRoute | replace("\\", "\\\\") | replace("'", "\\'") | replace("\n", "\\n") }}';
      {%- if isolatedDemos %}
  readonly isolatedDemos: boolean = true;
      {%- endif %}
    {%- endif %}

  constructor() {
    super();
  }
}
{#- The route has no title of its own: it inherits the title of its tab route, so a page's own
    `route.title` is the only title here and wins over the generated one. #}
{%- if contentSourceImport %}

// The router shows the page only once its content has loaded, so the previous page stays on
// screen instead of an empty page.
const routes: Routes = [ɵwithNgDocContent({
    {%- if entryPath %}
  ...(isRoute(entry.route) ? entry.route : {}),
    {%- endif %}
  path: '',
  component: PageComponent,
}, pageContentSource)]
{%- else %}

const routes: Routes = [{
    {%- if entryPath %}
  ...(isRoute(entry.route) ? entry.route : {}),
    {%- endif %}
  path: '',
  component: PageComponent,
}]
{%- endif %}

export default routes;

