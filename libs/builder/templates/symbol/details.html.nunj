{#-
    The details of a declaration as a definition list: decorators, selectors, type parameters and
    heritage, the same data as `api/details`. The `rail` variant also names the kind, its modifiers
    and the scope; the page moves it into the right rail.
-#}
{% import "helpers/type.html.nunj" as typeMacro %}
{% import "helpers/tag.html.nunj" as tagMacro %}
{% import "helpers/declaration-modifiers.html.nunj" as modifiersMacro %}
{% import "symbol/decorators.html.nunj" as decoratorsMacro %}

{% macro render(declaration, scope, variant) %}
    {%- set isClass = Node.isClassDeclaration(declaration) %}
    {%- set decorators = declaration.getDecorators() if isClass else [] %}
    {%- set selectors = declaration | extractSelectors %}
    {%- set typeParameters = declaration.getTypeParameters() if declaration.getTypeParameters else [] %}
    {%- if isClass %}
        {%- set extends = [declaration.getExtends()] if declaration.getExtends() else [] %}
        {%- set implements = declaration.getImplements() %}
    {%- elseif Node.isInterfaceDeclaration(declaration) %}
        {%- set extends = declaration.getExtends() %}
        {%- set implements = [] %}
    {%- else %}
        {%- set extends = [] %}
        {%- set implements = [] %}
    {%- endif %}
    {%- set declarationType = declaration | getDeclarationType %}
    {%- set rail = variant == 'rail' %}
    {%- if rail or decorators.length or selectors.length or typeParameters.length or extends.length or implements.length %}
        {#- The content copy indexes what the per-section layout did (the selectors); the rail copy is
            not indexed. #}
        <dl class="ng-doc-api-details"{% if rail %} data-ng-doc-variant="rail" data-ng-doc-rail-details hidden indexable="false"{% endif %}>
            {%- if rail and declarationType %}
                <dt indexable="false">Kind</dt>
                <dd>{{ tagMacro.render("Type alias" if declarationType == "TypeAlias" else declarationType, declarationType) }}{{ modifiersMacro.render(declaration) }}</dd>
            {%- endif %}
            {%- if decorators.length %}
                <dt indexable="false">Decorators</dt>
                <dd indexable="false">{{ decoratorsMacro.render(decorators) }}</dd>
            {%- endif %}
            {%- if selectors.length %}
                <dt indexable="false">Selectors</dt>
                <dd>{% for selector in selectors %}<code>{{ selector }}</code>{% endfor %}</dd>
            {%- endif %}
            {%- if typeParameters.length %}
                <dt indexable="false">Generic types</dt>
                <dd>{% for typeParameter in typeParameters %}{{ typeMacro.type(typeParameter) }}{% endfor %}</dd>
            {%- endif %}
            {%- if extends.length %}
                <dt indexable="false">Extends</dt>
                <dd>{% for item in extends %}{{ typeMacro.type(item) }}{% endfor %}</dd>
            {%- endif %}
            {%- if implements.length %}
                <dt indexable="false">Implements</dt>
                <dd>{% for item in implements %}{{ typeMacro.type(item) }}{% endfor %}</dd>
            {%- endif %}
            {%- if rail %}
                <dt indexable="false">Scope</dt>
                <dd>{{ scope.name }}</dd>
            {%- endif %}
        </dl>
    {%- endif %}
{% endmacro %}
