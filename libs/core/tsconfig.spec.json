{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "preserve",
    "types": ["node"],
    "moduleResolution": "bundler",
    "isolatedModules": true
  },
  "include": ["**/*.test.ts", "**/*.spec.ts", "**/*.d.ts"],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
