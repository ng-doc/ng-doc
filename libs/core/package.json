{
  "name": "@ng-doc/core",
  "version": "0.0.1",
  "description": "Page, category and API configuration types and helpers for NgDoc.",
  "keywords": [
    "angular",
    "documentation",
    "docs",
    "ng-doc",
    "markdown",
    "api-documentation"
  ],
  "homepage": "https://ng-doc.com/",
  "bugs": {
    "url": "https://github.com/ng-doc/ng-doc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ng-doc/ng-doc.git",
    "directory": "libs/core"
  },
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./classes": {
      "types": "./classes/index.d.ts",
      "default": "./classes/index.js"
    },
    "./constants": {
      "types": "./constants/index.d.ts",
      "default": "./constants/index.js"
    },
    "./helpers": {
      "types": "./helpers/index.d.ts",
      "default": "./helpers/index.js"
    },
    "./interfaces": {
      "types": "./interfaces/index.d.ts",
      "default": "./interfaces/index.js"
    },
    "./types": {
      "types": "./types/index.d.ts",
      "default": "./types/index.js"
    },
    "./*": {
      "types": "./*.d.ts",
      "default": "./*.js"
    }
  },
  "dependencies": {
    "posthtml-render": "3.0.0",
    "posthtml-parser": "0.11.0",
    "css-what": "6.1.0",
    "esthetic": "0.5.6-beta.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
