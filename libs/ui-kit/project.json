{
  "name": "ui-kit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/ui-kit",
  "prefix": "ng-doc",
  "tags": ["type:lib", "lib:ui-kit"],
  "targets": {
    "pre-build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/ui-kit/ng-package.json",
        "tsConfig": "libs/ui-kit/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ui-kit/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/ui-kit/styles"],
      "options": {
        "commands": [
          "sass --no-source-map libs/ui-kit/styles/main.scss dist/libs/ui-kit/styles/main.css"
        ]
      }
    },
    "schematics": {
      "executor": "nx:run-commands",
      "options": {
        "commands": []
      }
    },
    "build-specs": {
      "executor": "@angular/build:application",
      "metadata": {
        "description": "Build options for the unit-test builder only (test, test-zoneless); it is not a build of the library."
      },
      "options": {
        "outputPath": "dist/spec/libs/ui-kit",
        "tsConfig": "libs/ui-kit/tsconfig.spec.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": ["libs/ui-kit/styles"]
        },
        "polyfills": ["zone.js"]
      },
      "configurations": {
        "zoneless": {
          "polyfills": []
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/ui-kit"],
      "options": {
        "buildTarget": "ui-kit:build-specs",
        "tsConfig": "libs/ui-kit/tsconfig.spec.json",
        "runnerConfig": "libs/ui-kit/vitest.config.ts",
        "setupFiles": ["libs/ui-kit/test-setup.ts"],
        "isolate": true,
        "watch": false
      },
      "configurations": {
        "ci": {
          "coverage": true
        }
      }
    },
    "test-zoneless": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/libs/ui-kit-zoneless"],
      "options": {
        "buildTarget": "ui-kit:build-specs:zoneless",
        "tsConfig": "libs/ui-kit/tsconfig.spec.json",
        "runnerConfig": "libs/ui-kit/vitest.zoneless.config.ts",
        "setupFiles": ["libs/ui-kit/test-setup.ts"],
        "isolate": true,
        "watch": false
      },
      "configurations": {
        "ci": {
          "coverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
