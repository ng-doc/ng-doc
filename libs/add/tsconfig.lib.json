{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["schematics/**/*"],
  "exclude": [
    "schematics/*/files/**/*",
    "schematics/**/testing/**/*",
    "vitest.config.ts",
    "**/*.spec.ts",
    "**/*.test.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
