{
  "name": "add",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "",
  "projectType": "library",
  "tags": ["type:lib", "lib:add"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "outputPath": "dist/libs/add",
        "main": "libs/add/schematics/index.ts",
        "tsConfig": "libs/add/tsconfig.lib.json",
        "assets": [
          "libs/add/*.md",
          "libs/add/schematics/**/*.json",
          "libs/add/schematics/**/files/**/*"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "{workspaceRoot}/tools/vitest/**/*"],
      "outputs": ["{workspaceRoot}/coverage/libs/add"],
      "options": {
        "commands": [
          {
            "command": "tsc -p libs/add/tsconfig.spec.json --noEmit",
            "forwardAllArgs": false
          },
          "vitest run --config libs/add/vitest.config.ts"
        ],
        "parallel": false
      },
      "configurations": {
        "ci": {
          "commands": [
            {
              "command": "tsc -p libs/add/tsconfig.spec.json --noEmit",
              "forwardAllArgs": false
            },
            "vitest run --config libs/add/vitest.config.ts --coverage"
          ]
        }
      }
    }
  }
}
