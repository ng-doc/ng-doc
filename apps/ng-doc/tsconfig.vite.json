{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "paths": {
      "@ng-doc/app": ["dist/libs/app/index"],
      "@ng-doc/app/*": ["dist/libs/app/*"],
      "@ng-doc/builder": ["dist/libs/builder/index"],
      "@ng-doc/core": ["dist/libs/core/index"],
      "@ng-doc/core/*": ["dist/libs/core/*"],
      "@ng-doc/generated": ["ng-doc-modernization/ng-doc/ng-doc-vite/index"],
      "@ng-doc/ui-kit": ["dist/libs/ui-kit/index"],
      "@ng-doc/ui-kit/*": ["dist/libs/ui-kit/*"],
      "@ng-doc/utils": ["dist/libs/utils/index"],
      "@ng-doc/utils/*": ["dist/libs/utils/*"]
    }
  },
  "files": ["src/main.ts", "src/main.server.ts"],
  "include": ["src/**/*.d.ts"]
}
