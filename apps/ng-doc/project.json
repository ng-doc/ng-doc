{
  "name": "ng-doc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ng-doc/src",
  "prefix": "ng-doc",
  "tags": ["type:app", "app:ng-doc"],
  "implicitDependencies": ["builder"],
  "targets": {
    "build-legacy": {
      "executor": "./dist/libs/builder:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": [
        {
          "target": "link-libs"
        }
      ],
      "options": {
        "outputPath": "dist/apps/ng-doc",
        "index": "apps/ng-doc/src/index.html",
        "browser": "apps/ng-doc/src/main.ts",
        "inlineStyleLanguage": "scss",
        "server": "apps/ng-doc/src/main.server.ts",
        "prerender": true,
        "ssr": {
          "entry": "apps/ng-doc/server.ts"
        },
        "assets": [
          "apps/ng-doc/src/assets",
          {
            "glob": "**/*",
            "input": "dist/libs/app/assets",
            "output": "assets/ng-doc/app"
          },
          {
            "glob": "**/*",
            "input": "dist/libs/ui-kit/assets",
            "output": "assets/ng-doc/ui-kit"
          },
          {
            "glob": "**/*",
            "input": "ng-doc/ng-doc/assets",
            "output": "assets/ng-doc"
          }
        ],
        "styles": ["apps/ng-doc/src/styles.scss"],
        "scripts": [],
        "allowedCommonJsDependencies": [
          "@ng-doc/core",
          "posthtml-parser",
          "posthtml-render",
          "js-beautify",
          "chalk"
        ]
      },
      "configurations": {
        "production": {
          "tsConfig": "apps/ng-doc/tsconfig.build.json",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "10mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "10kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/ng-doc/src/environments/environment.ts",
              "with": "apps/ng-doc/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all",
          "sourceMap": true
        },
        "development": {
          "tsConfig": "apps/ng-doc/tsconfig.app.json",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "link-libs": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "dependencies": true
        }
      ],
      "options": {
        "commands": [
          "symlink-dir dist/libs/core dist/libs/builder/node_modules/@ng-doc/core",
          "symlink-dir dist/libs/core dist/libs/utils/node_modules/@ng-doc/core",
          "symlink-dir dist/libs/utils dist/libs/builder/node_modules/@ng-doc/utils",
          "symlink-dir dist/libs/core node_modules/@ng-doc/core",
          "symlink-dir dist/libs/utils node_modules/@ng-doc/utils",
          "symlink-dir dist/libs/keywords-loaders node_modules/@ng-doc/keywords-loaders",
          "symlink-dir dist/libs/builder node_modules/@ng-doc/builder",
          "symlink-dir dist/libs/app node_modules/@ng-doc/app",
          "symlink-dir dist/libs/ui-kit node_modules/@ng-doc/ui-kit"
        ]
      }
    },
    "serve-legacy": {
      "executor": "./dist/libs/builder:dev-server",
      "defaultConfiguration": "development",
      "dependsOn": [
        {
          "target": "link-libs"
        }
      ],
      "configurations": {
        "production": {
          "buildTarget": "ng-doc:build-legacy:production",
          "tsConfig": "apps/ng-doc/tsconfig.build.json"
        },
        "development": {
          "buildTarget": "ng-doc:build-legacy:development"
        },
        "poc": {
          "buildTarget": "ng-doc:build-legacy:development",
          "ngDoc": {
            "config": "apps/ng-doc/ng-doc.config.poc.ts"
          }
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "ng-doc:build-legacy"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build-specs": {
      "executor": "@angular/build:application",
      "metadata": {
        "description": "Build options for the unit-test builder only (test); it is not a build of the site."
      },
      "options": {
        "outputPath": "dist/spec/apps/ng-doc",
        "tsConfig": "apps/ng-doc/tsconfig.spec.json",
        "inlineStyleLanguage": "scss",
        "polyfills": ["zone.js"]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/apps/ng-doc"],
      "options": {
        "buildTarget": "ng-doc:build-specs",
        "tsConfig": "apps/ng-doc/tsconfig.spec.json",
        "runnerConfig": "apps/ng-doc/vitest.config.ts",
        "isolate": true,
        "watch": false
      },
      "configurations": {
        "ci": {
          "coverage": true
        }
      }
    },
    "build-modern": {
      "executor": "./dist/libs/builder:modern-application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": [
        {
          "target": "link-libs"
        }
      ],
      "options": {
        "outputPath": "dist/apps/ng-doc-modern",
        "index": "apps/ng-doc/src/index.html",
        "browser": "apps/ng-doc/src/main.ts",
        "inlineStyleLanguage": "scss",
        "server": "apps/ng-doc/src/main.server.ts",
        "prerender": true,
        "ssr": {
          "entry": "apps/ng-doc/server.ts"
        },
        "assets": [
          "apps/ng-doc/src/assets",
          {
            "glob": "**/*",
            "input": "dist/libs/app/assets",
            "output": "assets/ng-doc/app"
          },
          {
            "glob": "**/*",
            "input": "dist/libs/ui-kit/assets",
            "output": "assets/ng-doc/ui-kit"
          },
          {
            "glob": "**/*",
            "input": "ng-doc/ng-doc/assets",
            "output": "assets/ng-doc"
          }
        ],
        "styles": ["apps/ng-doc/src/styles.scss"],
        "scripts": [],
        "allowedCommonJsDependencies": [
          "@ng-doc/core",
          "posthtml-parser",
          "posthtml-render",
          "js-beautify",
          "chalk"
        ],
        "ngDoc": {
          "config": "apps/ng-doc/ng-doc.config.modern.ts"
        }
      },
      "configurations": {
        "production": {
          "tsConfig": "apps/ng-doc/tsconfig.modern.json",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "10mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "10kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/ng-doc/src/environments/environment.ts",
              "with": "apps/ng-doc/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all",
          "sourceMap": true
        },
        "development": {
          "tsConfig": "apps/ng-doc/tsconfig.modern.json",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve-modern": {
      "executor": "./dist/libs/builder:modern-dev-server",
      "defaultConfiguration": "development",
      "dependsOn": [
        {
          "target": "link-libs"
        }
      ],
      "configurations": {
        "production": {
          "buildTarget": "ng-doc:build-modern:production"
        },
        "development": {
          "buildTarget": "ng-doc:build-modern:development"
        }
      }
    },
    "build": {
      "executor": "./tools/builders:vite-application",
      "outputs": ["{options.outputPath}"],
      "dependsOn": [
        {
          "target": "link-libs"
        }
      ],
      "options": {
        "configFile": "apps/ng-doc/vite.config.mjs",
        "outputPath": "dist/apps/ng-doc-vite"
      }
    },
    "serve": {
      "executor": "./tools/builders:vite-dev-server",
      "dependsOn": [
        {
          "target": "link-libs"
        }
      ],
      "options": {
        "configFile": "apps/ng-doc/vite.config.mjs"
      }
    }
  }
}
