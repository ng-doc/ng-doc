{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@ng-doc/add": ["libs/add/src/index.ts"],
      "@ng-doc/app": ["libs/app/index.ts"],
      "@ng-doc/app/*": ["libs/app/*"],
      "@ng-doc/builder": ["libs/builder/index.ts"],
      "@ng-doc/builder/testing/*": ["libs/builder/testing/*"],
      "@ng-doc/core": ["libs/core/index.ts"],
      "@ng-doc/core/*": ["libs/core/*"],
      "@ng-doc/generated": ["apps/ng-doc/ng-doc-generated.stub.ts"],
      "@ng-doc/keywords-loaders": ["libs/keywords-loaders/index.ts"],
      "@ng-doc/ui-kit": ["libs/ui-kit/index.ts"],
      "@ng-doc/ui-kit/*": ["libs/ui-kit/*"],
      "@ng-doc/utils": ["libs/utils/index.ts"],
      "@ng-doc/utils/*": ["libs/utils/*"]
    }
  }
}
